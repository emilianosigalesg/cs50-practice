//"Greedy algorithm" to return change to user while minimizing number of coins that go out
#include <cs50.h>
#include <stdio.h>

int main(void)
{

    int change_owed;

    do
    {
        change_owed = get_int("Change owed: ");
    }
    while (change_owed < 0);

    int quarters = change_owed / 25;
    int dimes = (change_owed % 25) / 10;
    int nickels = ((change_owed % 25) % 10) / 5;
    int pennies = ((change_owed % 25) % 10) % 5;

    printf("%i\n", quarters + dimes + nickels + pennies);
}
